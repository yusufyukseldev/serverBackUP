@page "/repositories"
@using System.Security.Cryptography
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ServerBackup.Core.Repository
@using ServerBackup.Data
@using ServerBackup.Data.Entities
@using ServerBackup.Engine.Backup
@using ServerBackup.Engine.Prune
@using ServerBackup.Engine.Repository
@using ServerBackup.Engine.Retention
@using ServerBackup.Engine.Scanning
@using ServerBackup.Engine.Verify
@using ServerBackup.Service.Formatting
@using ServerBackup.Service.Scheduling
@using ServerBackup.Service.Storage
@inject IOptions<ServerBackupOptions> Options

<PageHeader Title="Depolar" />

<div class="sb-content">
@if (_rows is null)
{
    <SbSkeleton />
}
else if (_rows.Count == 0)
{
    <SbEmptyState Message="Yapılandırılmış depo yok. appsettings.json içindeki ServerBackup:Repositories listesine bir depo yolu ekleyin." />
}
else
{
    <div class="sb-table-wrap"><table class="sb-table">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Yol</th>
                <th>Durum</th>
                <th>Erişim</th>
                <th class="r">Snapshot</th>
                <th class="r">Boyut</th>
                <th>Disk</th>
                <th>Son doğrulama</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr class="@(row.Exists ? "is-clickable" : "")"
                    tabindex="@(row.Exists ? 0 : -1)"
                    @onclick="() => OpenDrawerAsync(row)"
                    @onkeydown="e => OnRowKeyDownAsync(e, row)">
                    <td class="sb-name">@row.DisplayName</td>
                    <td class="path" title="@row.RepoPath">@Fmt.TruncatePath(row.RepoPath, 30)</td>
                    <td>
                        @if (row.Exists)
                        {
                            <SbStatusChip Status="Succeeded" Text="Hazır" />
                        }
                        else
                        {
                            <SbStatusChip Status="Failed" Text="catalog.db yok" />
                        }
                    </td>
                    <td>
                        <span class="sb-row">
                            <SbIcon Name="@(row.UnattendedEnabled ? "unlock" : "lock")" Small="true" />
                            @(row.UnattendedEnabled ? "Açık" : "Kapalı")
                        </span>
                    </td>
                    <td class="r num">@row.SnapshotCount</td>
                    <td class="r num">@Fmt.Bytes(row.TotalBytes)</td>
                    <td>
                        @if (row.DiskPercent is { } p)
                        {
                            <SbDiskBar Percent="p" />
                        }
                        else
                        {
                            <span class="sb-hint">—</span>
                        }
                    </td>
                    <td class="sb-hint">—</td>
                </tr>
            }
        </tbody>
    </table></div>
}
</div>

<SbDrawer Title="@(_selectedRow?.DisplayName ?? "")" Open="@(_selectedRow is not null)" OnClose="CloseDrawer">
    @if (_selectedRow is not null)
    {
        <div class="sb-fs">
            <div class="sb-fs-title">ÖZET</div>
            <dl class="sb-dl">
                <dt>Yol</dt><dd class="mono">@_selectedRow.RepoPath</dd>
                <dt>Format sürümü</dt><dd>@(_drawerConfig?.FormatVersion.ToString() ?? "—")</dd>
                <dt>Oluşturma tarihi</dt><dd>@(_drawerConfig is null ? "—" : Fmt.DateTime(_drawerConfig.CreatedAtUtc))</dd>
                <dt>Parola → anahtar</dt><dd class="mono">Argon2id — m=64 MiB, t=3, p=4</dd>
                <dt>Veri şifreleme</dt><dd class="mono">AES-256-GCM</dd>
                <dt>Alt anahtarlar</dt><dd class="mono">HKDF-SHA256</dd>
            </dl>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">KULLANIM</div>
            <dl class="sb-dl">
                <dt>Pack</dt><dd>@Fmt.Number(_selectedRow.PackCount)</dd>
                <dt>Blob</dt><dd>@Fmt.Number(_selectedRow.BlobCount)</dd>
                <dt>Dedup oranı</dt><dd>— (dedup öncesi boyut izlenmiyor)</dd>
                <dt>Disk doluluk</dt><dd>@(_selectedRow.DiskPercent is { } dp ? $"%{dp}" : "—")</dd>
            </dl>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">GÜVENLİK</div>
            <dl class="sb-dl">
                <dt>Gözetimsiz erişim</dt><dd>@(_selectedRow.UnattendedEnabled ? "Açık (DPAPI)" : "Kapalı — parola gerekli")</dd>
                <dt>Append-only</dt><dd>@(_drawerConfig?.AppendOnly is true ? "Açık" : "Kapalı")</dd>
                <dt>Değişmezlik penceresi</dt><dd>@(_drawerConfig?.ImmutabilityWindowDays is { } d ? $"{d} gün" : "Yok")</dd>
                <dt>ACL durumu</dt><dd>—</dd>
            </dl>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">DOĞRULAMA GEÇMİŞİ</div>
            <p class="sb-hint">Doğrulama geçmişi şu an tutulmuyor.</p>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">EYLEMLER</div>
            <div class="sb-row">
                <SbButton Variant="SbButtonVariant.Primary" OnClick="OpenBackupDialog">Yedek al</SbButton>
                <SbButton OnClick="OpenVerifyDialog">Doğrula</SbButton>
                <SbButton
                    Variant="SbButtonVariant.DangerOutline"
                    OnClick="OpenPruneDialog"
                    Disabled="@(!CanPrune)"
                    DisabledReason="@PruneDisabledReason">
                    Buda
                </SbButton>
            </div>
        </div>
    }
</SbDrawer>

<SbDialog Title="Yedek al" Description="@(_selectedRow?.RepoPath)" Open="_backupDialogOpen" OnClose="CloseBackupDialog" Size="SbDialogSize.Md">
    <ChildContent>
        <div class="sb-stack">
            <SbField Label="Kaynak yollar" Group="true" Hint="Bir diski seçmek o diskin tamamını yedekler; okunamayan sistem klasörleri atlanır.">
                <SbPathPicker Paths="_backupPaths" PathsChanged="p => _backupPaths = p" />
            </SbField>

            @if (_selectedRow is not null && !_selectedRow.UnattendedEnabled)
            {
                <SbField Label="Parola" For="f-backup-pwd">
                    <input class="sb-input" type="password" id="f-backup-pwd" @bind="_backupPassword" />
                </SbField>
            }

            @if (_backupMessage is not null)
            {
                <p>@_backupMessage</p>
            }
        </div>
    </ChildContent>
    <Footer>
        <SbButton OnClick="CloseBackupDialog">Vazgeç</SbButton>
        <SbButton
            Variant="SbButtonVariant.Primary"
            OnClick="RunBackupNowAsync"
            Disabled="@_backupRunning"
            DisabledReason="@(_backupRunning ? "Yedekleme zaten sürüyor" : null)">
            @(_backupRunning ? "Yedekleniyor..." : "Başlat")
        </SbButton>
    </Footer>
</SbDialog>

<SbDialog Title="Depoyu doğrula" Description="@(_selectedRow?.RepoPath)" Open="_verifyDialogOpen" OnClose="CloseVerifyDialog" Size="SbDialogSize.Md">
    <ChildContent>
        <div class="sb-stack">
            <SbField Label="Doğrulama seviyesi" For="f-verify-level">
                <select class="sb-select" id="f-verify-level" @bind="_verifyLevel">
                    <option value="Index">Hızlı — katalog tutarlılığı</option>
                    <option value="Packs">Pack bütünlüğü — SHA-256</option>
                    <option value="Full">Tam — her blob'u çöz ve doğrula</option>
                </select>
            </SbField>

            @if (_selectedRow is not null && !_selectedRow.UnattendedEnabled)
            {
                <SbField Label="Parola" For="f-verify-pwd">
                    <input class="sb-input" type="password" id="f-verify-pwd" @bind="_verifyPassword" />
                </SbField>
            }

            @if (_verifyIssues is not null)
            {
                @if (_verifyIssues.Count == 0)
                {
                    <SbBanner Tone="SbBannerTone.Ok" Icon="check" Title="Sorun bulunamadı" />
                }
                else
                {
                    <SbBanner Tone="SbBannerTone.Err" Icon="alert" Title="@($"{_verifyIssues.Count} sorun bulundu")" />
                    <div class="sb-log">
                        @foreach (var issue in _verifyIssues)
                        {
                            <div>[@issue.Category] @issue.Description</div>
                        }
                    </div>
                }
            }
            else if (_verifyMessage is not null)
            {
                <p>@_verifyMessage</p>
            }
        </div>
    </ChildContent>
    <Footer>
        <SbButton OnClick="CloseVerifyDialog">Vazgeç</SbButton>
        <SbButton
            OnClick="RunVerifyAsync"
            Disabled="@_verifyRunning"
            DisabledReason="@(_verifyRunning ? "Doğrulama zaten sürüyor" : null)">
            @(_verifyRunning ? "Doğrulanıyor..." : "Doğrulamayı başlat")
        </SbButton>
    </Footer>
</SbDialog>

@if (_pruneDialogOpen && _selectedRow is not null)
{
    <SbConfirmDialog
        Title="@($"{_selectedRow.DisplayName} budanacak")"
        Consequence="Bu depodaki saklama politikası dışında kalan snapshot'lar ve artık kullanılmayan pack'ler kalıcı olarak silinir. Bu işlem geri alınamaz."
        ConfirmWord="@_selectedRow.DisplayName"
        ConfirmLabel="@(_pruneRunning ? "Budanıyor..." : "Budayı çalıştır")"
        OnConfirm="RunPruneAsync"
        OnCancel="ClosePruneDialog" />
}
@if (_pruneMessage is not null)
{
    <div class="sb-overlay">
        <div class="sb-dialog sb-dialog--sm">
            <div class="sb-dialog-head"><h3>Buda sonucu</h3></div>
            <div class="sb-dialog-body"><p>@_pruneMessage</p></div>
            <div class="sb-dialog-foot"><SbButton Variant="SbButtonVariant.Primary" OnClick="@(() => _pruneMessage = null)">Kapat</SbButton></div>
        </div>
    </div>
}

@code {
    private sealed record RepoRow(
        string RepoPath, string DisplayName, bool Exists, bool UnattendedEnabled,
        int PackCount, int BlobCount, int SnapshotCount, long TotalBytes, int? DiskPercent);

    private List<RepoRow>? _rows;
    private RepoRow? _selectedRow;
    private RepositoryConfig? _drawerConfig;
    private int _drawerPlanCount;
    private PlanEntity? _drawerSinglePlan;

    private bool _backupDialogOpen;
    private IReadOnlyList<string> _backupPaths = [];
    private string _backupPassword = "";
    private bool _backupRunning;
    private string? _backupMessage;

    private bool _verifyDialogOpen;
    private string _verifyLevel = nameof(VerifyLevel.Index);
    private string _verifyPassword = "";
    private bool _verifyRunning;
    private IReadOnlyList<VerifyIssue>? _verifyIssues;
    private string? _verifyMessage;

    private bool _pruneDialogOpen;
    private bool _pruneRunning;
    private string? _pruneMessage;

    private bool CanPrune => _drawerPlanCount == 1;

    private string? PruneDisabledReason => _drawerPlanCount switch
    {
        0 => "Bu depoya bağlı bir plan yok, saklama politikası belirlenemiyor",
        1 => null,
        _ => "Birden fazla plan var — hangi saklama politikasının kullanılacağı belirsiz",
    };

    protected override async Task OnInitializedAsync()
    {
        var rows = new List<RepoRow>();

        foreach (var repoPath in Options.Value.Repositories)
        {
            var dbPath = Path.Combine(repoPath, "catalog.db");
            var unattended = UnattendedKeyStore.IsEnabled(repoPath);
            var displayName = RepoNaming.DisplayName(repoPath);
            var diskPercent = DiskUsage.GetUsedPercent(repoPath);

            if (!File.Exists(dbPath))
            {
                rows.Add(new RepoRow(repoPath, displayName, false, unattended, 0, 0, 0, 0, diskPercent));
                continue;
            }

            await using var db = CatalogDbContextFactory.Create(dbPath);
            rows.Add(new RepoRow(
                repoPath,
                displayName,
                true,
                unattended,
                await db.Packs.CountAsync(),
                await db.Blobs.CountAsync(),
                await db.Snapshots.CountAsync(),
                await db.Packs.SumAsync(p => (long?)p.SizeBytes) ?? 0,
                diskPercent));
        }

        _rows = rows;
    }

    private async Task OpenDrawerAsync(RepoRow row)
    {
        if (!row.Exists)
        {
            return;
        }

        _selectedRow = row;
        _drawerConfig = await RepositoryManager.ReadConfigAsync(row.RepoPath);

        await using var db = CatalogDbContextFactory.Create(Path.Combine(row.RepoPath, "catalog.db"));
        var plans = await db.Plans.AsNoTracking().ToListAsync();
        _drawerPlanCount = plans.Count;
        _drawerSinglePlan = plans.Count == 1 ? plans[0] : null;
    }

    private async Task OnRowKeyDownAsync(KeyboardEventArgs e, RepoRow row)
    {
        if (e.Key is "Enter" or " ")
        {
            await OpenDrawerAsync(row);
        }
    }

    private void CloseDrawer()
    {
        _selectedRow = null;
        _drawerConfig = null;
        _drawerSinglePlan = null;
    }

    private void OpenBackupDialog()
    {
        _backupPaths = [];
        _backupPassword = "";
        _backupMessage = null;
        _backupDialogOpen = true;
    }

    private void CloseBackupDialog() => _backupDialogOpen = false;

    private async Task RunBackupNowAsync()
    {
        if (_selectedRow is null)
        {
            return;
        }

        _backupMessage = null;

        var sourcePaths = _backupPaths.ToArray();
        if (sourcePaths.Length == 0)
        {
            _backupMessage = "En az bir kaynak yol seçin.";
            return;
        }

        var repoPath = _selectedRow.RepoPath;
        var unattended = _selectedRow.UnattendedEnabled;

        byte[] masterKey;
        try
        {
            masterKey = unattended
                ? UnattendedKeyStore.Unlock(repoPath)
                : await RepositoryKeyStore.UnlockAsync(repoPath, _backupPassword);
        }
        catch (UnauthorizedAccessException)
        {
            _backupMessage = "Parola yanlış.";
            return;
        }

        _backupRunning = true;
        try
        {
            await using var db = CatalogDbContextFactory.Create(Path.Combine(repoPath, "catalog.db"));
            var parentSnapshotId = (await db.Snapshots.AsNoTracking().ToListAsync())
                .OrderByDescending(s => s.StartedAtUtc)
                .FirstOrDefault()
                ?.SnapshotId;

            BackupProgress? lastProgress = null;
            var engine = new BackupEngine(
                new LocalSourceProvider(), repoPath, masterKey,
                filter: new ScanFilter(sourcePaths[0]),
                progress: new Progress<BackupProgress>(p => lastProgress = p));
            var snapshotId = await engine.RunAsync(sourcePaths, parentSnapshotId);

            var skipped = lastProgress?.EntriesSkipped ?? 0;
            _backupMessage = skipped > 0
                ? $"Tamamlandı — snapshot {snapshotId}. {skipped} öğe okunamadığı için atlandı."
                : $"Tamamlandı — snapshot {snapshotId}.";
            _backupDialogOpen = false;
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _backupMessage = $"Yedekleme başarısız: {ex.Message}";
        }
        finally
        {
            CryptographicOperations.ZeroMemory(masterKey);
            _backupRunning = false;
        }
    }

    private void OpenVerifyDialog()
    {
        _verifyLevel = nameof(VerifyLevel.Index);
        _verifyPassword = "";
        _verifyIssues = null;
        _verifyMessage = null;
        _verifyDialogOpen = true;
    }

    private void CloseVerifyDialog() => _verifyDialogOpen = false;

    private async Task RunVerifyAsync()
    {
        if (_selectedRow is null)
        {
            return;
        }

        _verifyMessage = null;
        _verifyIssues = null;

        var repoPath = _selectedRow.RepoPath;
        byte[] masterKey;
        try
        {
            masterKey = _selectedRow.UnattendedEnabled
                ? UnattendedKeyStore.Unlock(repoPath)
                : await RepositoryKeyStore.UnlockAsync(repoPath, _verifyPassword);
        }
        catch (UnauthorizedAccessException)
        {
            _verifyMessage = "Parola yanlış.";
            return;
        }

        _verifyRunning = true;
        try
        {
            var level = Enum.Parse<VerifyLevel>(_verifyLevel);
            var engine = new VerifyEngine(repoPath, masterKey);
            _verifyIssues = await engine.RunAsync(level);
        }
        catch (Exception ex)
        {
            _verifyMessage = $"Doğrulama başarısız: {ex.Message}";
        }
        finally
        {
            CryptographicOperations.ZeroMemory(masterKey);
            _verifyRunning = false;
        }
    }

    private void OpenPruneDialog()
    {
        _pruneMessage = null;
        _pruneDialogOpen = true;
    }

    private void ClosePruneDialog() => _pruneDialogOpen = false;

    private async Task RunPruneAsync()
    {
        if (_selectedRow is null || _drawerSinglePlan is null)
        {
            return;
        }

        var repoPath = _selectedRow.RepoPath;
        byte[] masterKey;
        try
        {
            masterKey = _selectedRow.UnattendedEnabled
                ? UnattendedKeyStore.Unlock(repoPath)
                : throw new UnauthorizedAccessException("Bu depo gözetimsiz erişime açık değil — buda için önce Ayarlar'dan açık erişimi etkinleştirin.");
        }
        catch (UnauthorizedAccessException ex)
        {
            _pruneMessage = ex.Message;
            _pruneDialogOpen = false;
            return;
        }

        _pruneRunning = true;
        try
        {
            var policy = _drawerSinglePlan.RetentionPolicyJson is null
                ? new RetentionPolicy()
                : System.Text.Json.JsonSerializer.Deserialize<RetentionPolicy>(_drawerSinglePlan.RetentionPolicyJson) ?? new RetentionPolicy();

            var engine = new PruneEngine(repoPath, masterKey);
            var result = await engine.RunAsync(policy, dryRun: false);

            _pruneMessage = $"{result.SnapshotsToDelete.Count} snapshot silindi, {Fmt.Bytes(result.BytesFreed)} boşaltıldı.";
            _pruneDialogOpen = false;
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _pruneMessage = $"Buda başarısız: {ex.Message}";
        }
        finally
        {
            CryptographicOperations.ZeroMemory(masterKey);
            _pruneRunning = false;
        }
    }
}
