@page "/repositories"
@using System.Security.Cryptography
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ServerBackup.Data
@using ServerBackup.Engine.Backup
@using ServerBackup.Engine.Repository
@using ServerBackup.Engine.Scanning
@using ServerBackup.Service.Scheduling
@inject IOptions<ServerBackupOptions> Options

<div class="sb-content">
<h1>Depolar</h1>

@if (_rows is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Yol</th>
                <th>Durum</th>
                <th>Parolasız Erişim</th>
                <th>Pack</th>
                <th>Blob</th>
                <th>Snapshot</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td>@row.RepoPath</td>
                    <td>
                        @if (row.Exists)
                        {
                            <span class="badge badge-ok">Hazır</span>
                        }
                        else
                        {
                            <span class="badge badge-err">catalog.db yok</span>
                        }
                    </td>
                    <td>
                        @if (row.UnattendedEnabled)
                        {
                            <span class="badge badge-ok">Açık</span>
                        }
                        else
                        {
                            <span class="badge badge-muted">Kapalı</span>
                        }
                    </td>
                    <td>@row.PackCount</td>
                    <td>@row.BlobCount</td>
                    <td>@row.SnapshotCount</td>
                    <td>
                        @if (row.Exists)
                        {
                            <SbButton OnClick="() => ToggleBackupForm(row.RepoPath)">Yedek Al</SbButton>
                        }
                    </td>
                </tr>
                @if (_backupFormRepo == row.RepoPath)
                {
                    <tr>
                        <td colspan="7">
                            <div class="sb-stack">
                                <SbField Label="Kaynak Yollar (virgülle ayrılmış)">
                                    <input class="sb-input" @bind="_backupSourcePaths" placeholder="C:\Veri, D:\Projeler" />
                                </SbField>

                                @if (!row.UnattendedEnabled)
                                {
                                    <SbField Label="Parola">
                                        <input class="sb-input" type="password" @bind="_backupPassword" />
                                    </SbField>
                                }

                                <SbButton
                                    OnClick="() => RunBackupNowAsync(row.RepoPath, row.UnattendedEnabled)"
                                    Disabled="@_backupRunning"
                                    DisabledReason="@(_backupRunning ? "Yedekleme zaten sürüyor" : null)">
                                    @(_backupRunning ? "Yedekleniyor..." : "Şimdi Başlat")
                                </SbButton>

                                @if (_backupMessage is not null)
                                {
                                    <p>@_backupMessage</p>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
</div>

@code {
    private sealed record RepoRow(string RepoPath, bool Exists, bool UnattendedEnabled, int PackCount, int BlobCount, int SnapshotCount);

    private List<RepoRow>? _rows;
    private string? _backupFormRepo;
    private string _backupSourcePaths = "";
    private string _backupPassword = "";
    private bool _backupRunning;
    private string? _backupMessage;

    private void ToggleBackupForm(string repoPath)
    {
        _backupFormRepo = _backupFormRepo == repoPath ? null : repoPath;
        _backupSourcePaths = "";
        _backupPassword = "";
        _backupMessage = null;
    }

    /// <summary>
    /// Ad-hoc "yedek al" click from the panel — no saved Plan required. Chains
    /// to the repo's most recent snapshot (regardless of which plan made it)
    /// so this run is still incremental, matching what a scheduled plan run
    /// would do (see BackupSchedulerService).
    private async Task RunBackupNowAsync(string repoPath, bool unattended)
    {
        _backupMessage = null;

        var sourcePaths = _backupSourcePaths.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (sourcePaths.Length == 0)
        {
            _backupMessage = "En az bir kaynak yol girin.";
            return;
        }

        byte[] masterKey;
        try
        {
            masterKey = unattended
                ? UnattendedKeyStore.Unlock(repoPath)
                : await RepositoryKeyStore.UnlockAsync(repoPath, _backupPassword);
        }
        catch (UnauthorizedAccessException)
        {
            _backupMessage = "Parola yanlış.";
            return;
        }

        _backupRunning = true;
        try
        {
            await using var db = CatalogDbContextFactory.Create(Path.Combine(repoPath, "catalog.db"));
            var parentSnapshotId = (await db.Snapshots.AsNoTracking().ToListAsync())
                .OrderByDescending(s => s.StartedAtUtc)
                .FirstOrDefault()
                ?.SnapshotId;

            var engine = new BackupEngine(new LocalSourceProvider(), repoPath, masterKey);
            var snapshotId = await engine.RunAsync(sourcePaths, parentSnapshotId);

            _backupMessage = $"Tamamlandı — snapshot {snapshotId}.";
            _backupFormRepo = null;
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _backupMessage = $"Yedekleme başarısız: {ex.Message}";
        }
        finally
        {
            CryptographicOperations.ZeroMemory(masterKey);
            _backupRunning = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var rows = new List<RepoRow>();

        foreach (var repoPath in Options.Value.Repositories)
        {
            var dbPath = Path.Combine(repoPath, "catalog.db");
            var unattended = UnattendedKeyStore.IsEnabled(repoPath);

            if (!File.Exists(dbPath))
            {
                rows.Add(new RepoRow(repoPath, false, unattended, 0, 0, 0));
                continue;
            }

            await using var db = CatalogDbContextFactory.Create(dbPath);
            rows.Add(new RepoRow(
                repoPath,
                true,
                unattended,
                await db.Packs.CountAsync(),
                await db.Blobs.CountAsync(),
                await db.Snapshots.CountAsync()));
        }

        _rows = rows;
    }
}
