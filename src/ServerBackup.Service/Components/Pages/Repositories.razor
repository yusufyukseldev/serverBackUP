@page "/repositories"
@using System.Security.Cryptography
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ServerBackup.Core.Repository
@using ServerBackup.Data
@using ServerBackup.Data.Entities
@using ServerBackup.Engine.Backup
@using ServerBackup.Engine.Prune
@using ServerBackup.Engine.Repository
@using ServerBackup.Engine.Retention
@using ServerBackup.Engine.Scanning
@using ServerBackup.Engine.Verify
@using ServerBackup.Service.Formatting
@using ServerBackup.Service.Scheduling
@using ServerBackup.Service.Storage
@inject RepositoryRegistry Repos

<PageHeader Title="Depolar">
    <Actions>
        <SbButton Variant="SbButtonVariant.Primary" Icon="plus" OnClick="OpenAddDialog">Depo ekle</SbButton>
    </Actions>
</PageHeader>

<div class="sb-content">
@if (_message is not null)
{
    <SbBanner Tone="@_messageTone" Icon="@(_messageTone == SbBannerTone.Err ? "alert" : "check")" Title="@_message" />
}

@if (_rows is null)
{
    <SbSkeleton />
}
else if (_rows.Count == 0)
{
    <SbEmptyState Message="Henüz depo yok. Bir depo, yedeklerin şifreli olarak yazıldığı klasördür — yerel disk, USB veya ağ paylaşımı olabilir."
                  ActionText="Depo ekle" OnAction="OpenAddDialog" />
}
else
{
    <div class="sb-table-wrap"><table class="sb-table">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Yol</th>
                <th>Durum</th>
                <th>Erişim</th>
                <th class="r">Snapshot</th>
                <th class="r">Boyut</th>
                <th>Disk</th>
                <th>Son doğrulama</th>
                <th><span class="sb-sr-only">Eylemler</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr class="@(row.Exists ? "is-clickable" : "")"
                    tabindex="@(row.Exists ? 0 : -1)"
                    @onclick="() => OpenDrawerAsync(row)"
                    @onkeydown="e => OnRowKeyDownAsync(e, row)">
                    <td class="sb-name">@row.DisplayName</td>
                    <td class="path" title="@row.RepoPath">@Fmt.TruncatePath(row.RepoPath, 30)</td>
                    <td>
                        @if (row.Exists)
                        {
                            <SbStatusChip Status="Succeeded" Text="Hazır" />
                        }
                        else
                        {
                            <SbStatusChip Status="Failed" Text="catalog.db yok" />
                        }
                    </td>
                    <td>
                        <span class="sb-row">
                            <SbIcon Name="@(row.UnattendedEnabled ? "unlock" : "lock")" Small="true" />
                            @(row.UnattendedEnabled ? "Açık" : "Kapalı")
                        </span>
                    </td>
                    <td class="r num">@row.SnapshotCount</td>
                    <td class="r num">@Fmt.Bytes(row.TotalBytes)</td>
                    <td>
                        @if (row.DiskPercent is { } p)
                        {
                            <SbDiskBar Percent="p" />
                        }
                        else
                        {
                            <span class="sb-hint">—</span>
                        }
                    </td>
                    <td class="sb-hint">—</td>
                    @* Satırın kendisi çekmeceyi açıyor; bu hücredeki tık oraya sızmamalı. *@
                    <td class="r" @onclick:stopPropagation="true">
                        <SbButton Size="SbButtonSize.Sm" Variant="SbButtonVariant.Subtle" Icon="unlink"
                                  AriaLabel="@($"'{row.DisplayName}' deposunun bağlantısını kaldır")"
                                  OnClick="() => AskDetach(row)" />
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
}
</div>

<SbDrawer Title="@(_selectedRow?.DisplayName ?? "")" Open="@(_selectedRow is not null)" OnClose="CloseDrawer">
    @if (_selectedRow is not null)
    {
        <div class="sb-fs">
            <div class="sb-fs-title">ÖZET</div>
            <dl class="sb-dl">
                <dt>Yol</dt><dd class="mono">@_selectedRow.RepoPath</dd>
                <dt>Format sürümü</dt><dd>@(_drawerConfig?.FormatVersion.ToString() ?? "—")</dd>
                <dt>Oluşturma tarihi</dt><dd>@(_drawerConfig is null ? "—" : Fmt.DateTime(_drawerConfig.CreatedAtUtc))</dd>
                <dt>Parola → anahtar</dt><dd class="mono">Argon2id — m=64 MiB, t=3, p=4</dd>
                <dt>Veri şifreleme</dt><dd class="mono">AES-256-GCM</dd>
                <dt>Alt anahtarlar</dt><dd class="mono">HKDF-SHA256</dd>
            </dl>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">KULLANIM</div>
            <dl class="sb-dl">
                <dt>Pack</dt><dd>@Fmt.Number(_selectedRow.PackCount)</dd>
                <dt>Blob</dt><dd>@Fmt.Number(_selectedRow.BlobCount)</dd>
                <dt>Dedup oranı</dt><dd>— (dedup öncesi boyut izlenmiyor)</dd>
                <dt>Disk doluluk</dt><dd>@(_selectedRow.DiskPercent is { } dp ? $"%{dp}" : "—")</dd>
            </dl>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">GÜVENLİK</div>
            <dl class="sb-dl">
                <dt>Gözetimsiz erişim</dt><dd>@(_selectedRow.UnattendedEnabled ? "Açık (DPAPI)" : "Kapalı — parola gerekli")</dd>
                <dt>Append-only</dt><dd>@(_drawerConfig?.AppendOnly is true ? "Açık" : "Kapalı")</dd>
                <dt>Değişmezlik penceresi</dt><dd>@(_drawerConfig?.ImmutabilityWindowDays is { } d ? $"{d} gün" : "Yok")</dd>
                <dt>ACL durumu</dt><dd>—</dd>
            </dl>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">DOĞRULAMA GEÇMİŞİ</div>
            <p class="sb-hint">Doğrulama geçmişi şu an tutulmuyor.</p>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">EYLEMLER</div>
            <div class="sb-row">
                <SbButton Variant="SbButtonVariant.Primary" OnClick="OpenBackupDialog">Yedek al</SbButton>
                <SbButton OnClick="OpenVerifyDialog">Doğrula</SbButton>
                <SbButton
                    Variant="SbButtonVariant.DangerOutline"
                    OnClick="OpenPruneDialog"
                    Disabled="@(!CanPrune)"
                    DisabledReason="@PruneDisabledReason">
                    Buda
                </SbButton>
            </div>
        </div>
    }
</SbDrawer>

<SbDialog Title="Depo ekle" Description="Var olan bir depoyu panele bağlayın ya da yeni bir depo oluşturun."
          Open="_addDialogOpen" OnClose="CloseAddDialog">
    <ChildContent>
        <div class="sb-stack">
            <SbField Label="Ne yapmak istiyorsunuz?" Group="true">
                <div class="sb-stack">
                    <label class="sb-check">
                        <input type="radio" name="addmode" value="attach"
                               checked="@(!_addCreateNew)" @onchange="() => SetAddMode(false)" />
                        <span>
                            <strong>Var olan bir depoyu bağla</strong>
                            <span class="sb-hint">Başka bir sunucuda ya da USB diskte oluşturulmuş bir depoyu bu panele tanıt.</span>
                        </span>
                    </label>
                    <label class="sb-check">
                        <input type="radio" name="addmode" value="create"
                               checked="@_addCreateNew" @onchange="() => SetAddMode(true)" />
                        <span>
                            <strong>Yeni depo oluştur</strong>
                            <span class="sb-hint">Boş bir klasörde sıfırdan şifreli bir depo kur.</span>
                        </span>
                    </label>
                </div>
            </SbField>

            @if (_addCreateNew)
            {
                <SbField Label="Nerede oluşturulsun?" For="f-add-parent"
                         Hint="Seçilen klasörün altında, verdiğiniz adla yeni bir klasör açılır.">
                    <input class="sb-input sb-input--mono" id="f-add-parent" @bind="_addParentPath" placeholder="D:\Yedekler" />
                </SbField>

                <SbPathPicker Single="true" Paths="AddParentPaths" PathsChanged="OnAddParentPicked" />

                <SbField Label="Depo adı" For="f-add-name">
                    <input class="sb-input" id="f-add-name" @bind="_addRepoName" placeholder="Muhasebe-Depo" />
                </SbField>

                <SbField Label="Depo parolası" For="f-add-pwd"
                         Hint="Bu parola olmadan yedekler açılamaz — kaybolursa veri kurtarılamaz. En az 8 karakter.">
                    <input class="sb-input" type="password" id="f-add-pwd" @bind="_addPassword" />
                </SbField>
                <SbField Label="Parola (tekrar)" For="f-add-pwd2">
                    <input class="sb-input" type="password" id="f-add-pwd2" @bind="_addPasswordAgain" />
                </SbField>

                <SbField Label="Koruma" Group="true">
                    <div class="sb-stack">
                        <label class="sb-check">
                            <input type="checkbox" @bind="_addUnattended" />
                            <span>
                                <strong>Servis parolasız açabilsin (DPAPI)</strong>
                                <span class="sb-hint">Zamanlanmış yedekler bunsuz çalışamaz. Karşılığı: bu makinede SYSTEM yetkisi ele geçiren biri depoyu açabilir.</span>
                            </span>
                        </label>
                        <label class="sb-check">
                            <input type="checkbox" @bind="_addAppendOnly" />
                            <span>
                                <strong>Append-only</strong>
                                <span class="sb-hint">Hiçbir snapshot silinemez; budama da çalışmaz. Fidye yazılımına karşı en katı kip.</span>
                            </span>
                        </label>
                    </div>
                </SbField>

                @if (!_addAppendOnly)
                {
                    <SbField Label="Değişmezlik penceresi (gün)" For="f-add-imm" Width="SbFieldWidth.Xs"
                             Hint="Bu yaştan genç snapshot'lar panelden bile silinemez. Boş bırakılırsa pencere yok.">
                        <input type="number" min="0" class="sb-input" id="f-add-imm" @bind="_addImmutabilityDays" />
                    </SbField>
                }
            }
            else
            {
                <SbField Label="Depo klasörü" For="f-add-path"
                         Hint="İçinde config.json bulunan klasörü seçin.">
                    <input class="sb-input sb-input--mono" id="f-add-path" @bind="_addPath" placeholder="D:\Yedekler\Muhasebe-Depo" />
                </SbField>

                <SbPathPicker Single="true" Paths="AddPaths" PathsChanged="OnAddPathPicked" />
            }

            @if (_addError is not null)
            {
                <SbBanner Tone="SbBannerTone.Err" Icon="alert" Title="@_addError" />
            }
        </div>
    </ChildContent>
    <Footer>
        <SbButton OnClick="CloseAddDialog">Vazgeç</SbButton>
        <SbButton Variant="SbButtonVariant.Primary" OnClick="AddRepositoryAsync"
                  Disabled="@_addRunning" DisabledReason="@(_addRunning ? "İşlem sürüyor" : null)">
            @(_addRunning ? "Oluşturuluyor..." : _addCreateNew ? "Depoyu oluştur" : "Depoyu bağla")
        </SbButton>
    </Footer>
</SbDialog>

<SbDialog Title="Bağlantıyı kaldır" Size="SbDialogSize.Sm"
          Description="@($"'{_detachTarget?.DisplayName}' bu panelden çıkarılacak.")"
          Open="@(_detachTarget is not null)" OnClose="() => _detachTarget = null">
    <ChildContent>
        <SbBanner Tone="SbBannerTone.Warn" Icon="alert"
                  Title="Diskteki veriler silinmez"
                  Body="Depo klasörü olduğu gibi kalır; tek bir yedek bile silinmez. Yalnızca bu panel onu yönetmeyi bırakır: planları çalışmaz, snapshot'ları listelenmez. Aynı yolu tekrar bağlayınca her şey geri gelir." />
        @if (_detachTarget is not null)
        {
            <dl class="sb-dl">
                <dt>Yol</dt><dd class="mono">@_detachTarget.RepoPath</dd>
                <dt>Snapshot</dt><dd>@_detachTarget.SnapshotCount</dd>
            </dl>
        }
    </ChildContent>
    <Footer>
        <SbButton OnClick="() => _detachTarget = null">Vazgeç</SbButton>
        <SbButton Variant="SbButtonVariant.Danger" Icon="unlink" OnClick="DetachRepositoryAsync">Bağlantıyı kaldır</SbButton>
    </Footer>
</SbDialog>

<SbDialog Title="Yedek al" Description="@(_selectedRow?.RepoPath)" Open="_backupDialogOpen" OnClose="CloseBackupDialog" Size="SbDialogSize.Md">
    <ChildContent>
        <div class="sb-stack">
            <SbField Label="Kaynak yollar" Group="true" Hint="Bir diski seçmek o diskin tamamını yedekler; okunamayan sistem klasörleri atlanır.">
                <SbPathPicker Paths="_backupPaths" PathsChanged="p => _backupPaths = p" />
            </SbField>

            @if (_selectedRow is not null && !_selectedRow.UnattendedEnabled)
            {
                <SbField Label="Parola" For="f-backup-pwd">
                    <input class="sb-input" type="password" id="f-backup-pwd" @bind="_backupPassword" />
                </SbField>
            }

            @if (_backupMessage is not null)
            {
                <p>@_backupMessage</p>
            }
        </div>
    </ChildContent>
    <Footer>
        <SbButton OnClick="CloseBackupDialog">Vazgeç</SbButton>
        <SbButton
            Variant="SbButtonVariant.Primary"
            OnClick="RunBackupNowAsync"
            Disabled="@_backupRunning"
            DisabledReason="@(_backupRunning ? "Yedekleme zaten sürüyor" : null)">
            @(_backupRunning ? "Yedekleniyor..." : "Başlat")
        </SbButton>
    </Footer>
</SbDialog>

<SbDialog Title="Depoyu doğrula" Description="@(_selectedRow?.RepoPath)" Open="_verifyDialogOpen" OnClose="CloseVerifyDialog" Size="SbDialogSize.Md">
    <ChildContent>
        <div class="sb-stack">
            <SbField Label="Doğrulama seviyesi" For="f-verify-level">
                <select class="sb-select" id="f-verify-level" @bind="_verifyLevel">
                    <option value="Index">Hızlı — katalog tutarlılığı</option>
                    <option value="Packs">Pack bütünlüğü — SHA-256</option>
                    <option value="Full">Tam — her blob'u çöz ve doğrula</option>
                </select>
            </SbField>

            @if (_selectedRow is not null && !_selectedRow.UnattendedEnabled)
            {
                <SbField Label="Parola" For="f-verify-pwd">
                    <input class="sb-input" type="password" id="f-verify-pwd" @bind="_verifyPassword" />
                </SbField>
            }

            @if (_verifyIssues is not null)
            {
                @if (_verifyIssues.Count == 0)
                {
                    <SbBanner Tone="SbBannerTone.Ok" Icon="check" Title="Sorun bulunamadı" />
                }
                else
                {
                    <SbBanner Tone="SbBannerTone.Err" Icon="alert" Title="@($"{_verifyIssues.Count} sorun bulundu")" />
                    <div class="sb-log">
                        @foreach (var issue in _verifyIssues)
                        {
                            <div>[@issue.Category] @issue.Description</div>
                        }
                    </div>
                }
            }
            else if (_verifyMessage is not null)
            {
                <p>@_verifyMessage</p>
            }
        </div>
    </ChildContent>
    <Footer>
        <SbButton OnClick="CloseVerifyDialog">Vazgeç</SbButton>
        <SbButton
            OnClick="RunVerifyAsync"
            Disabled="@_verifyRunning"
            DisabledReason="@(_verifyRunning ? "Doğrulama zaten sürüyor" : null)">
            @(_verifyRunning ? "Doğrulanıyor..." : "Doğrulamayı başlat")
        </SbButton>
    </Footer>
</SbDialog>

<SbDialog Title="Depoyu buda" Description="@(_selectedRow?.RepoPath)" Open="_pruneDialogOpen" OnClose="ClosePruneDialog" Size="SbDialogSize.Md">
    <ChildContent>
        <div class="sb-stack">
            @if (_selectedRow is not null && !_selectedRow.UnattendedEnabled && _prunePreview is null)
            {
                <SbField Label="Parola" For="f-prune-pwd">
                    <input class="sb-input" type="password" id="f-prune-pwd" @bind="_prunePassword" />
                </SbField>
            }

            @if (_pruneError is not null)
            {
                <SbBanner Tone="SbBannerTone.Err" Icon="alert" Title="@_pruneError" />
            }

            @if (_prunePreview is null)
            {
                <p class="sb-hint">
                    Hiçbir şey silinmeden önce, bu planın saklama politikasının hangi snapshot'ları
                    sileceğini önizleyin.
                </p>
            }
            else if (_prunePreview.SnapshotsToDelete.Count == 0)
            {
                <SbBanner Tone="SbBannerTone.Ok" Icon="check" Title="Silinecek snapshot yok" Body="Saklama politikası şu an hiçbir snapshot'ı budama kapsamına almıyor." />
            }
            else
            {
                <SbBanner Tone="SbBannerTone.Warn" Icon="alert"
                          Title="@($"{_prunePreview.SnapshotsToDelete.Count} snapshot silinecek")"
                          Body="@($"{_prunePreview.PacksToDelete.Count} pack tamamen silinecek, {_prunePreview.PacksToRepack.Count} pack yeniden paketlenecek. Bu işlem geri alınamaz.")" />

                <div class="sb-table-wrap">
                    <table class="sb-table">
                        <thead>
                            <tr><th scope="col">Tarih</th><th scope="col">Snapshot</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _prunePreviewSnapshots ?? [])
                            {
                                <tr><td class="num">@Fmt.DateTime(s.StartedAtUtc)</td><td class="id">@s.SnapshotId[..8]</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <SbButton OnClick="ClosePruneDialog">Vazgeç</SbButton>
        @if (_prunePreview is null)
        {
            <SbButton Variant="SbButtonVariant.Primary" OnClick="PreviewPruneAsync"
                      Disabled="@_pruneBusy" DisabledReason="@(_pruneBusy ? "Önizleme sürüyor" : null)">
                @(_pruneBusy ? "Önizleniyor..." : "Önizlemeyi göster")
            </SbButton>
        }
        else if (_prunePreview.SnapshotsToDelete.Count > 0)
        {
            <SbButton Variant="SbButtonVariant.Danger" Icon="trash" OnClick="ApplyPruneAsync"
                      Disabled="@_pruneBusy" DisabledReason="@(_pruneBusy ? "Budama sürüyor" : null)">
                @(_pruneBusy ? "Budanıyor..." : "Budayı çalıştır")
            </SbButton>
        }
    </Footer>
</SbDialog>
@if (_pruneMessage is not null)
{
    <div class="sb-overlay">
        <div class="sb-dialog sb-dialog--sm">
            <div class="sb-dialog-head"><h3>Buda sonucu</h3></div>
            <div class="sb-dialog-body"><p>@_pruneMessage</p></div>
            <div class="sb-dialog-foot"><SbButton Variant="SbButtonVariant.Primary" OnClick="@(() => _pruneMessage = null)">Kapat</SbButton></div>
        </div>
    </div>
}

@code {
    private sealed record RepoRow(
        string RepoPath, string DisplayName, bool Exists, bool UnattendedEnabled,
        int PackCount, int BlobCount, int SnapshotCount, long TotalBytes, int? DiskPercent);

    private List<RepoRow>? _rows;
    private RepoRow? _selectedRow;

    private bool _addDialogOpen;
    private bool _addCreateNew;
    private bool _addRunning;
    private string? _addError;
    private string _addPath = "";
    private string _addParentPath = "";
    private string _addRepoName = "";
    private string _addPassword = "";
    private string _addPasswordAgain = "";
    private bool _addUnattended = true;
    private bool _addAppendOnly;
    private int? _addImmutabilityDays;

    private RepoRow? _detachTarget;
    private string? _message;
    private SbBannerTone _messageTone = SbBannerTone.Ok;
    private RepositoryConfig? _drawerConfig;
    private int _drawerPlanCount;
    private PlanEntity? _drawerSinglePlan;

    private bool _backupDialogOpen;
    private IReadOnlyList<string> _backupPaths = [];
    private string _backupPassword = "";
    private bool _backupRunning;
    private string? _backupMessage;

    private bool _verifyDialogOpen;
    private string _verifyLevel = nameof(VerifyLevel.Index);
    private string _verifyPassword = "";
    private bool _verifyRunning;
    private IReadOnlyList<VerifyIssue>? _verifyIssues;
    private string? _verifyMessage;

    private bool _pruneDialogOpen;
    private bool _pruneBusy;
    private string _prunePassword = "";
    private string? _pruneError;
    private string? _pruneMessage;
    private PruneResult? _prunePreview;
    private List<SnapshotEntity>? _prunePreviewSnapshots;

    private bool CanPrune => _drawerPlanCount == 1;

    private string? PruneDisabledReason => _drawerPlanCount switch
    {
        0 => "Bu depoya bağlı bir plan yok, saklama politikası belirlenemiyor",
        1 => null,
        _ => "Birden fazla plan var — hangi saklama politikasının kullanılacağı belirsiz",
    };

    protected override async Task OnInitializedAsync() => await LoadRowsAsync();

    private async Task LoadRowsAsync()
    {
        var rows = new List<RepoRow>();

        foreach (var repoPath in Repos.Paths)
        {
            var dbPath = Path.Combine(repoPath, "catalog.db");
            var unattended = UnattendedKeyStore.IsEnabled(repoPath);
            var displayName = RepoNaming.DisplayName(repoPath);
            var diskPercent = DiskUsage.GetUsedPercent(repoPath);

            if (!File.Exists(dbPath))
            {
                rows.Add(new RepoRow(repoPath, displayName, false, unattended, 0, 0, 0, 0, diskPercent));
                continue;
            }

            await using var db = CatalogDbContextFactory.Create(dbPath);
            rows.Add(new RepoRow(
                repoPath,
                displayName,
                true,
                unattended,
                await db.Packs.CountAsync(),
                await db.Blobs.CountAsync(),
                await db.Snapshots.CountAsync(),
                await db.Packs.SumAsync(p => (long?)p.SizeBytes) ?? 0,
                diskPercent));
        }

        _rows = rows;
    }

    private IReadOnlyList<string> AddPaths => string.IsNullOrWhiteSpace(_addPath) ? [] : [_addPath];

    private IReadOnlyList<string> AddParentPaths => string.IsNullOrWhiteSpace(_addParentPath) ? [] : [_addParentPath];

    private void OnAddPathPicked(IReadOnlyList<string> paths) => _addPath = paths.Count == 0 ? "" : paths[0];

    private void OnAddParentPicked(IReadOnlyList<string> paths) => _addParentPath = paths.Count == 0 ? "" : paths[0];

    private void OpenAddDialog()
    {
        (_addPath, _addParentPath, _addRepoName) = ("", "", "");
        (_addPassword, _addPasswordAgain) = ("", "");
        (_addUnattended, _addAppendOnly, _addImmutabilityDays) = (true, false, null);
        (_addCreateNew, _addError, _message) = (false, null, null);
        _addDialogOpen = true;
    }

    private void CloseAddDialog() => _addDialogOpen = false;

    private void SetAddMode(bool createNew)
    {
        _addCreateNew = createNew;
        _addError = null;
    }

    private async Task AddRepositoryAsync()
    {
        _addError = null;
        _addRunning = true;

        try
        {
            var repoPath = _addCreateNew ? await CreateRepositoryAsync() : AttachRepository();
            if (repoPath is null)
            {
                return;
            }

            // An attached repository may predate migrations this build added —
            // creation already migrates, this makes attach safe the same way.
            await using (var db = CatalogDbContextFactory.Create(Path.Combine(repoPath, "catalog.db")))
            {
                await db.Database.MigrateAsync();
            }

            Repos.Add(repoPath);
            _addDialogOpen = false;
            _messageTone = SbBannerTone.Ok;
            _message = _addCreateNew
                ? $"'{RepoNaming.DisplayName(repoPath)}' deposu oluşturuldu ve panele bağlandı."
                : $"'{RepoNaming.DisplayName(repoPath)}' deposu panele bağlandı.";

            await LoadRowsAsync();
        }
        catch (Exception ex)
        {
            _addError = ex.Message;
        }
        finally
        {
            _addRunning = false;
        }
    }

    /// <summary>Returns the path to register, or null when the form is not valid yet.</summary>
    private string? AttachRepository()
    {
        var path = _addPath.Trim();

        if (path.Length == 0)
        {
            _addError = "Bir depo klasörü seçin.";
            return null;
        }

        if (!FileSystemBrowser.DirectoryExists(path))
        {
            _addError = "Bu klasör bulunamadı.";
            return null;
        }

        // config.json is what makes a folder a repository; without it the panel
        // would list an empty row that no operation can use.
        if (!File.Exists(Path.Combine(path, "config.json")))
        {
            _addError = "Bu klasörde bir ServerBackup deposu yok (config.json bulunamadı).";
            return null;
        }

        if (Repos.Contains(path))
        {
            _addError = "Bu depo zaten panele bağlı.";
            return null;
        }

        return path;
    }

    private async Task<string?> CreateRepositoryAsync()
    {
        var parent = _addParentPath.Trim();
        var name = _addRepoName.Trim();

        if (parent.Length == 0)
        {
            _addError = "Deponun oluşturulacağı klasörü seçin.";
            return null;
        }

        if (name.Length == 0 || name.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
        {
            _addError = "Geçerli bir depo adı yazın (yol ayracı ve özel karakter içeremez).";
            return null;
        }

        if (_addPassword.Length < 8)
        {
            _addError = "Depo parolası en az 8 karakter olmalı.";
            return null;
        }

        if (_addPassword != _addPasswordAgain)
        {
            _addError = "Parolalar birbirini tutmuyor.";
            return null;
        }

        var repoPath = Path.Combine(parent, name);

        if (File.Exists(Path.Combine(repoPath, "config.json")))
        {
            _addError = "Bu yolda zaten bir depo var. Onu bağlamak için 'Var olan bir depoyu bağla' seçeneğini kullanın.";
            return null;
        }

        if (Directory.Exists(repoPath) && Directory.EnumerateFileSystemEntries(repoPath).Any())
        {
            _addError = "Bu klasör boş değil. Depo boş bir klasörde oluşturulmalı.";
            return null;
        }

        await RepositoryManager.InitializeAsync(
            repoPath, _addPassword, _addAppendOnly ? null : _addImmutabilityDays, _addAppendOnly);

        if (_addUnattended)
        {
            var masterKey = await RepositoryKeyStore.UnlockAsync(repoPath, _addPassword);
            try
            {
                UnattendedKeyStore.Enable(repoPath, masterKey);
            }
            finally
            {
                CryptographicOperations.ZeroMemory(masterKey);
            }
        }

        // Nothing further needs it, and it should not sit in the circuit's
        // memory for the rest of the session.
        (_addPassword, _addPasswordAgain) = ("", "");

        return repoPath;
    }

    private void AskDetach(RepoRow row)
    {
        _message = null;
        _detachTarget = row;
    }

    private async Task DetachRepositoryAsync()
    {
        if (_detachTarget is null)
        {
            return;
        }

        var row = _detachTarget;
        _detachTarget = null;

        // Unregister only. Deleting a repository means deleting every backup in
        // it, and that is never a side effect of a panel button.
        var removed = Repos.Remove(row.RepoPath);

        _messageTone = removed ? SbBannerTone.Ok : SbBannerTone.Warn;
        _message = removed
            ? $"'{row.DisplayName}' bağlantısı kaldırıldı. Klasördeki yedeklere dokunulmadı."
            : $"'{row.DisplayName}' zaten bağlı değildi.";

        if (_selectedRow?.RepoPath == row.RepoPath)
        {
            CloseDrawer();
        }

        await LoadRowsAsync();
    }

    private async Task OpenDrawerAsync(RepoRow row)
    {
        if (!row.Exists)
        {
            return;
        }

        _selectedRow = row;
        _drawerConfig = await RepositoryManager.ReadConfigAsync(row.RepoPath);

        await using var db = CatalogDbContextFactory.Create(Path.Combine(row.RepoPath, "catalog.db"));
        var plans = await db.Plans.AsNoTracking().ToListAsync();
        _drawerPlanCount = plans.Count;
        _drawerSinglePlan = plans.Count == 1 ? plans[0] : null;
    }

    private async Task OnRowKeyDownAsync(KeyboardEventArgs e, RepoRow row)
    {
        if (e.Key is "Enter" or " ")
        {
            await OpenDrawerAsync(row);
        }
    }

    private void CloseDrawer()
    {
        _selectedRow = null;
        _drawerConfig = null;
        _drawerSinglePlan = null;
    }

    private void OpenBackupDialog()
    {
        _backupPaths = [];
        _backupPassword = "";
        _backupMessage = null;
        _backupDialogOpen = true;
    }

    private void CloseBackupDialog() => _backupDialogOpen = false;

    private async Task RunBackupNowAsync()
    {
        if (_selectedRow is null)
        {
            return;
        }

        _backupMessage = null;

        var sourcePaths = _backupPaths.ToArray();
        if (sourcePaths.Length == 0)
        {
            _backupMessage = "En az bir kaynak yol seçin.";
            return;
        }

        var repoPath = _selectedRow.RepoPath;
        var unattended = _selectedRow.UnattendedEnabled;

        byte[] masterKey;
        try
        {
            masterKey = unattended
                ? UnattendedKeyStore.Unlock(repoPath)
                : await RepositoryKeyStore.UnlockAsync(repoPath, _backupPassword);
        }
        catch (UnauthorizedAccessException)
        {
            _backupMessage = "Parola yanlış.";
            return;
        }

        _backupRunning = true;
        try
        {
            await using var db = CatalogDbContextFactory.Create(Path.Combine(repoPath, "catalog.db"));
            var parentSnapshotId = (await db.Snapshots.AsNoTracking().ToListAsync())
                .OrderByDescending(s => s.StartedAtUtc)
                .FirstOrDefault()
                ?.SnapshotId;

            BackupProgress? lastProgress = null;
            var engine = new BackupEngine(
                new LocalSourceProvider(), repoPath, masterKey,
                filter: new ScanFilter(sourcePaths[0]),
                progress: new Progress<BackupProgress>(p => lastProgress = p));
            var snapshotId = await engine.RunAsync(sourcePaths, parentSnapshotId);

            var skipped = lastProgress?.EntriesSkipped ?? 0;
            _backupMessage = skipped > 0
                ? $"Tamamlandı — snapshot {snapshotId}. {skipped} öğe okunamadığı için atlandı."
                : $"Tamamlandı — snapshot {snapshotId}.";
            _backupDialogOpen = false;
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _backupMessage = $"Yedekleme başarısız: {ex.Message}";
        }
        finally
        {
            CryptographicOperations.ZeroMemory(masterKey);
            _backupRunning = false;
        }
    }

    private void OpenVerifyDialog()
    {
        _verifyLevel = nameof(VerifyLevel.Index);
        _verifyPassword = "";
        _verifyIssues = null;
        _verifyMessage = null;
        _verifyDialogOpen = true;
    }

    private void CloseVerifyDialog() => _verifyDialogOpen = false;

    private async Task RunVerifyAsync()
    {
        if (_selectedRow is null)
        {
            return;
        }

        _verifyMessage = null;
        _verifyIssues = null;

        var repoPath = _selectedRow.RepoPath;
        byte[] masterKey;
        try
        {
            masterKey = _selectedRow.UnattendedEnabled
                ? UnattendedKeyStore.Unlock(repoPath)
                : await RepositoryKeyStore.UnlockAsync(repoPath, _verifyPassword);
        }
        catch (UnauthorizedAccessException)
        {
            _verifyMessage = "Parola yanlış.";
            return;
        }

        _verifyRunning = true;
        try
        {
            var level = Enum.Parse<VerifyLevel>(_verifyLevel);
            var engine = new VerifyEngine(repoPath, masterKey);
            _verifyIssues = await engine.RunAsync(level);
        }
        catch (Exception ex)
        {
            _verifyMessage = $"Doğrulama başarısız: {ex.Message}";
        }
        finally
        {
            CryptographicOperations.ZeroMemory(masterKey);
            _verifyRunning = false;
        }
    }

    private void OpenPruneDialog()
    {
        _prunePassword = "";
        _pruneError = null;
        _pruneMessage = null;
        _prunePreview = null;
        _prunePreviewSnapshots = null;
        _pruneDialogOpen = true;
    }

    private void ClosePruneDialog() => _pruneDialogOpen = false;

    private RetentionPolicy CurrentRetentionPolicy() =>
        _drawerSinglePlan?.RetentionPolicyJson is null
            ? new RetentionPolicy()
            : System.Text.Json.JsonSerializer.Deserialize<RetentionPolicy>(_drawerSinglePlan.RetentionPolicyJson) ?? new RetentionPolicy();

    private async Task<byte[]?> UnlockForPruneAsync(string repoPath)
    {
        try
        {
            return _selectedRow!.UnattendedEnabled
                ? UnattendedKeyStore.Unlock(repoPath)
                : await RepositoryKeyStore.UnlockAsync(repoPath, _prunePassword);
        }
        catch (UnauthorizedAccessException)
        {
            _pruneError = "Parola yanlış.";
            return null;
        }
    }

    /// <summary>
    /// Nothing is deleted here. The operator must see exactly which snapshots
    /// the policy would remove before the destructive button even appears —
    /// this is what makes "budama" trustworthy after silent data loss.
    /// </summary>
    private async Task PreviewPruneAsync()
    {
        if (_selectedRow is null || _drawerSinglePlan is null)
        {
            return;
        }

        _pruneError = null;
        var repoPath = _selectedRow.RepoPath;
        var masterKey = await UnlockForPruneAsync(repoPath);
        if (masterKey is null)
        {
            return;
        }

        _pruneBusy = true;
        try
        {
            var engine = new PruneEngine(repoPath, masterKey);
            _prunePreview = await engine.RunAsync(CurrentRetentionPolicy(), dryRun: true, planId: _drawerSinglePlan.PlanId);

            await using var db = CatalogDbContextFactory.Create(Path.Combine(repoPath, "catalog.db"));
            _prunePreviewSnapshots = (await db.Snapshots.AsNoTracking()
                    .Where(s => _prunePreview.SnapshotsToDelete.Contains(s.SnapshotId))
                    .ToListAsync())
                .OrderByDescending(s => s.StartedAtUtc)
                .ToList();
        }
        catch (Exception ex)
        {
            _pruneError = $"Önizleme başarısız: {ex.Message}";
        }
        finally
        {
            CryptographicOperations.ZeroMemory(masterKey);
            _pruneBusy = false;
        }
    }

    private async Task ApplyPruneAsync()
    {
        if (_selectedRow is null || _drawerSinglePlan is null || _prunePreview is null)
        {
            return;
        }

        var repoPath = _selectedRow.RepoPath;
        var masterKey = await UnlockForPruneAsync(repoPath);
        if (masterKey is null)
        {
            return;
        }

        _pruneBusy = true;
        try
        {
            var engine = new PruneEngine(repoPath, masterKey);
            var result = await engine.RunAsync(CurrentRetentionPolicy(), dryRun: false, planId: _drawerSinglePlan.PlanId);

            _pruneMessage = $"{result.SnapshotsToDelete.Count} snapshot silindi, {Fmt.Bytes(result.BytesFreed)} boşaltıldı.";
            _pruneDialogOpen = false;
            await OnInitializedAsync();
        }
        catch (Exception ex)
        {
            _pruneMessage = $"Buda başarısız: {ex.Message}";
        }
        finally
        {
            CryptographicOperations.ZeroMemory(masterKey);
            _pruneBusy = false;
        }
    }
}
