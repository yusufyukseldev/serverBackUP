@page "/plans"
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ServerBackup.Data
@using ServerBackup.Data.Entities
@using ServerBackup.Engine.Retention
@using ServerBackup.Engine.Scheduling
@using ServerBackup.Service.Formatting
@using ServerBackup.Service.Scheduling
@using ServerBackup.Service.Storage
@inject IOptions<ServerBackupOptions> Options
@inject JobQueue Queue

<PageHeader Title="Planlar">
    <Actions>
        <SbButton Variant="SbButtonVariant.Primary" Icon="plus" OnClick="OpenCreateDialog"
                  Disabled="@(Options.Value.Repositories.Count == 0)"
                  DisabledReason="@(Options.Value.Repositories.Count == 0 ? "Önce bir depo yapılandırın" : null)">
            Yeni plan
        </SbButton>
    </Actions>
</PageHeader>

<div class="sb-content">
    <div class="sb-stack">
        @if (_message is not null)
        {
            <SbBanner Tone="@_messageTone" Icon="@(_messageTone == SbBannerTone.Err ? "alert" : "check")" Title="@_message" />
        }

        <SbCard Title="Yedekleme planları" Flush="true">
            @if (_plans is null)
            {
                <div class="sb-card-body"><SbSkeleton /></div>
            }
            else if (_plans.Count == 0)
            {
                <SbEmptyState Message="Henüz plan yok. Bir plan, hangi yolların hangi sıklıkta yedekleneceğini tanımlar."
                              ActionText="@(Options.Value.Repositories.Count == 0 ? null : "Yeni plan")"
                              OnAction="OpenCreateDialog" />
            }
            else
            {
                <div class="sb-table-wrap">
                    <table class="sb-table">
                        <thead>
                            <tr>
                                <th scope="col">Plan</th>
                                <th scope="col">Depo</th>
                                <th scope="col">Zamanlama</th>
                                <th scope="col">Kaynaklar</th>
                                <th scope="col">Saklama</th>
                                <th scope="col">Sonraki çalışma</th>
                                <th scope="col"><span class="sb-sr-only">Eylemler</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _plans)
                            {
                                <tr>
                                    <td class="sb-name">@row.Plan.Name</td>
                                    <td>
                                        <div>@RepoNaming.DisplayName(row.RepoPath)</div>
                                        <div class="path" title="@row.RepoPath">@Fmt.TruncatePath(row.RepoPath, 30)</div>
                                    </td>
                                    <td title="@row.Plan.CronSchedule">@CronText.Describe(row.Plan.CronSchedule)</td>
                                    <td>
                                        <span title="@string.Join("\n", row.SourcePaths)">
                                            @SourceSummary(row.SourcePaths)
                                        </span>
                                    </td>
                                    <td>@row.RetentionText</td>
                                    <td class="r num">@row.NextRunText</td>
                                    <td class="r">
                                        <SbButton Size="SbButtonSize.Sm"
                                                  OnClick="() => BackupNowAsync(row)"
                                                  Disabled="@(_queuedPlanId == row.Plan.PlanId)"
                                                  DisabledReason="@(_queuedPlanId == row.Plan.PlanId ? "Bu plan zaten kuyrukta" : null)">
                                            @(_queuedPlanId == row.Plan.PlanId ? "Kuyrukta" : "Şimdi yedekle")
                                        </SbButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </SbCard>
    </div>
</div>

<SbDialog Title="Yeni plan" Description="Kaynaklar, zamanlama ve saklama politikası."
          Open="_createDialogOpen" OnClose="CloseCreateDialog">
    <ChildContent>
        <div class="sb-fs">
            <div class="sb-fs-title">1 · Hedef ve kaynaklar</div>

            <SbField Label="Depo" For="f-plan-repo">
                <select class="sb-select" id="f-plan-repo" @bind="_form.RepoPath">
                    @foreach (var repoPath in Options.Value.Repositories)
                    {
                        <option value="@repoPath">@RepoNaming.DisplayName(repoPath) — @repoPath</option>
                    }
                </select>
            </SbField>

            <SbField Label="Plan adı" For="f-plan-name">
                <input class="sb-input" id="f-plan-name" @bind="_form.Name" placeholder="Muhasebe — günlük" />
            </SbField>

            <SbField Label="Kaynak yollar" Group="true" Hint="Bir diski seçmek o diskin tamamını yedekler; okunamayan sistem klasörleri atlanır.">
                <SbPathPicker Paths="_form.SourcePaths" PathsChanged="p => _form.SourcePaths = p" />
            </SbField>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">2 · Zamanlama</div>

            <label class="sb-check">
                <input type="checkbox" @bind="_form.UseSimpleScheduler" />
                Basit zamanlayıcı (gün, saat aralığı, sıklık)
            </label>

            @if (_form.UseSimpleScheduler)
            {
                <SbField Label="Günler" Group="true">
                    <div class="sb-row sb-row--wrap">
                        @foreach (var day in WeekDayOrder)
                        {
                            <label class="sb-check">
                                <input type="checkbox" checked="@_form.SelectedDays.Contains(day)"
                                       @onchange="e => ToggleDay(day, (bool)e.Value!)" />
                                @DayLabels[day]
                            </label>
                        }
                    </div>
                </SbField>

                <div class="sb-row">
                    <SbField Label="Başlangıç saati" For="f-plan-start" Width="SbFieldWidth.Xs">
                        <input type="number" min="0" max="23" class="sb-input" id="f-plan-start" @bind="_form.StartHour" />
                    </SbField>
                    <SbField Label="Bitiş saati" For="f-plan-end" Width="SbFieldWidth.Xs">
                        <input type="number" min="0" max="23" class="sb-input" id="f-plan-end" @bind="_form.EndHour" />
                    </SbField>
                    <SbField Label="Sıklık" For="f-plan-interval" Width="SbFieldWidth.Sm">
                        <select class="sb-select" id="f-plan-interval" @bind="_form.IntervalHours">
                            <option value="1">Her saat</option>
                            <option value="2">2 saatte bir</option>
                            <option value="3">3 saatte bir</option>
                            <option value="4">4 saatte bir</option>
                            <option value="6">6 saatte bir</option>
                            <option value="8">8 saatte bir</option>
                            <option value="12">12 saatte bir</option>
                            <option value="24">Günde 1 kere</option>
                        </select>
                    </SbField>
                </div>
            }
            else
            {
                <SbField Label="Cron ifadesi" For="f-plan-cron" Hint="Dakika saat gün ay haftagünü — örnek: 0 3 * * *">
                    <input class="sb-input sb-input--mono" id="f-plan-cron" @bind="_form.Cron" placeholder="0 3 * * *" />
                </SbField>
            }

            @{
                var preview = BuildPreview();
            }
            <div class="sb-preview">
                <div class="sb-preview-t">@preview.Description</div>
                <div class="sb-hint">@preview.NextRuns</div>
            </div>
        </div>

        <div class="sb-fs">
            <div class="sb-fs-title">3 · Saklama politikası</div>
            <div class="sb-row sb-row--wrap">
                <SbField Label="Son N" For="f-keep-last" Width="SbFieldWidth.Xs">
                    <input type="number" min="0" class="sb-input" id="f-keep-last" @bind="_form.KeepLast" />
                </SbField>
                <SbField Label="Günlük" For="f-keep-daily" Width="SbFieldWidth.Xs">
                    <input type="number" min="0" class="sb-input" id="f-keep-daily" @bind="_form.KeepDaily" />
                </SbField>
                <SbField Label="Haftalık" For="f-keep-weekly" Width="SbFieldWidth.Xs">
                    <input type="number" min="0" class="sb-input" id="f-keep-weekly" @bind="_form.KeepWeekly" />
                </SbField>
                <SbField Label="Aylık" For="f-keep-monthly" Width="SbFieldWidth.Xs">
                    <input type="number" min="0" class="sb-input" id="f-keep-monthly" @bind="_form.KeepMonthly" />
                </SbField>
                <SbField Label="Yıllık" For="f-keep-yearly" Width="SbFieldWidth.Xs">
                    <input type="number" min="0" class="sb-input" id="f-keep-yearly" @bind="_form.KeepYearly" />
                </SbField>
            </div>
            <p class="sb-hint">Boş bırakılan alanlar dikkate alınmaz. Hiçbiri doldurulmazsa snapshot'lar budanmaz.</p>
        </div>

        @if (_formError is not null)
        {
            <SbBanner Tone="SbBannerTone.Err" Icon="alert" Title="@_formError" />
        }
    </ChildContent>
    <Footer>
        <SbButton OnClick="CloseCreateDialog">Vazgeç</SbButton>
        <SbButton Variant="SbButtonVariant.Primary" OnClick="CreatePlanAsync">Plan oluştur</SbButton>
    </Footer>
</SbDialog>

@code {
    private sealed class PlanForm
    {
        public string RepoPath { get; set; } = "";
        public string Name { get; set; } = "";
        public IReadOnlyList<string> SourcePaths { get; set; } = [];
        public string Cron { get; set; } = "0 3 * * *";

        public int? KeepLast { get; set; }
        public int? KeepDaily { get; set; }
        public int? KeepWeekly { get; set; }
        public int? KeepMonthly { get; set; }
        public int? KeepYearly { get; set; }

        public bool UseSimpleScheduler { get; set; } = true;
        public HashSet<DayOfWeek> SelectedDays { get; set; } =
        [
            DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday,
        ];
        public int StartHour { get; set; } = 8;
        public int EndHour { get; set; } = 20;
        public int IntervalHours { get; set; } = 2;
    }

    private sealed record PlanRow(
        string RepoPath, PlanEntity Plan, IReadOnlyList<string> SourcePaths, string RetentionText, string NextRunText);

    private static readonly DayOfWeek[] WeekDayOrder =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];

    private static readonly Dictionary<DayOfWeek, string> DayLabels = new()
    {
        [DayOfWeek.Monday] = "Pzt", [DayOfWeek.Tuesday] = "Sal", [DayOfWeek.Wednesday] = "Çar",
        [DayOfWeek.Thursday] = "Per", [DayOfWeek.Friday] = "Cum", [DayOfWeek.Saturday] = "Cmt",
        [DayOfWeek.Sunday] = "Paz",
    };

    private List<PlanRow>? _plans;
    private PlanForm _form = new();
    private bool _createDialogOpen;
    private string? _formError;
    private string? _message;
    private SbBannerTone _messageTone = SbBannerTone.Ok;
    private string? _queuedPlanId;

    protected override async Task OnInitializedAsync() => await LoadPlansAsync();

    private void OpenCreateDialog()
    {
        _form = new PlanForm { RepoPath = Options.Value.Repositories.FirstOrDefault() ?? "" };
        _formError = null;
        _createDialogOpen = true;
    }

    private void CloseCreateDialog() => _createDialogOpen = false;

    private void ToggleDay(DayOfWeek day, bool selected)
    {
        if (selected)
        {
            _form.SelectedDays.Add(day);
        }
        else
        {
            _form.SelectedDays.Remove(day);
        }
    }

    /// <summary>
    /// "Günde bir kere" (24 saatte bir) seçilince bitiş saati başlangıçla
    /// eşitlenir — CronBuilder bunu tek bir sabit saat olarak yorumlar,
    /// aralık/adım üretmez.
    /// </summary>
    private string BuildCron() =>
        CronBuilder.Build(
            _form.SelectedDays,
            _form.StartHour,
            _form.IntervalHours >= 24 ? _form.StartHour : _form.EndHour,
            _form.IntervalHours >= 24 ? 1 : _form.IntervalHours);

    /// <summary>design-system.md §12.3 — the operator verifies the schedule from the next run times, not from cron syntax.</summary>
    private (string Description, string NextRuns) BuildPreview()
    {
        string cron;
        try
        {
            cron = _form.UseSimpleScheduler ? BuildCron() : _form.Cron;
            Cronos.CronExpression.Parse(cron, Cronos.CronFormat.Standard);
        }
        catch (Exception ex)
        {
            return ("Zamanlama geçersiz", ex.Message);
        }

        var runs = new List<string>();
        var cursor = DateTimeOffset.UtcNow;
        for (var i = 0; i < 3; i++)
        {
            var next = CronScheduleCalculator.GetNextOccurrence(cron, cursor);
            if (next is null)
            {
                break;
            }

            runs.Add(Fmt.DateTime(next.Value));
            cursor = next.Value;
        }

        return (CronText.Describe(cron),
            runs.Count == 0 ? "Sonraki çalışma bulunamadı." : $"Sonraki çalışmalar: {string.Join(" · ", runs)}");
    }

    private static string SourceSummary(IReadOnlyList<string> paths) => paths.Count switch
    {
        0 => "—",
        1 => Fmt.TruncatePath(paths[0], 28),
        _ => $"{Fmt.TruncatePath(paths[0], 20)} +{paths.Count - 1}",
    };

    private static string RetentionSummary(string? retentionJson)
    {
        if (string.IsNullOrEmpty(retentionJson))
        {
            return "Budanmaz";
        }

        var policy = JsonSerializer.Deserialize<RetentionPolicy>(retentionJson);
        if (policy is null)
        {
            return "Budanmaz";
        }

        var parts = new List<string>();
        if (policy.KeepLast is { } last) parts.Add($"son {last}");
        if (policy.KeepDaily is { } daily) parts.Add($"{daily} günlük");
        if (policy.KeepWeekly is { } weekly) parts.Add($"{weekly} haftalık");
        if (policy.KeepMonthly is { } monthly) parts.Add($"{monthly} aylık");
        if (policy.KeepYearly is { } yearly) parts.Add($"{yearly} yıllık");

        return parts.Count == 0 ? "Budanmaz" : string.Join(" · ", parts);
    }

    private async Task LoadPlansAsync()
    {
        var rows = new List<PlanRow>();

        foreach (var repoPath in Options.Value.Repositories)
        {
            var dbPath = Path.Combine(repoPath, "catalog.db");
            if (!File.Exists(dbPath))
            {
                continue;
            }

            await using var db = CatalogDbContextFactory.Create(dbPath);
            var plans = await db.Plans.AsNoTracking().ToListAsync();
            var snapshots = await db.Snapshots.AsNoTracking().ToListAsync();

            foreach (var plan in plans)
            {
                var lastRun = snapshots
                    .Where(s => s.PlanId == plan.PlanId)
                    .OrderByDescending(s => s.StartedAtUtc)
                    .FirstOrDefault()?.StartedAtUtc;

                rows.Add(new PlanRow(
                    repoPath,
                    plan,
                    JsonSerializer.Deserialize<string[]>(plan.SourcePathsJson) ?? [],
                    RetentionSummary(plan.RetentionPolicyJson),
                    NextRunText(plan.CronSchedule, lastRun)));
            }
        }

        _plans = rows;
    }

    private static string NextRunText(string? cron, DateTimeOffset? lastRunUtc)
    {
        if (string.IsNullOrWhiteSpace(cron))
        {
            return "—";
        }

        try
        {
            var next = CronScheduleCalculator.GetNextOccurrence(cron, lastRunUtc ?? DateTimeOffset.UtcNow);
            return next is null ? "—" : Fmt.DateTime(next.Value);
        }
        catch (Cronos.CronFormatException)
        {
            return "Geçersiz";
        }
    }

    private async Task BackupNowAsync(PlanRow row)
    {
        _message = null;

        await using var db = CatalogDbContextFactory.Create(Path.Combine(row.RepoPath, "catalog.db"));
        var alreadyQueued = await db.Jobs.AnyAsync(
            j => j.PlanId == row.Plan.PlanId && (j.Status == JobStatus.Pending || j.Status == JobStatus.Running));
        if (alreadyQueued)
        {
            _messageTone = SbBannerTone.Warn;
            _message = $"'{row.Plan.Name}' için zaten bekleyen veya çalışan bir iş var.";
            return;
        }

        var jobId = Guid.NewGuid().ToString("n");
        db.Jobs.Add(new JobEntity
        {
            JobId = jobId,
            PlanId = row.Plan.PlanId,
            Kind = "backup",
            Status = JobStatus.Pending,
        });
        await db.SaveChangesAsync();

        await Queue.Writer.WriteAsync(new ScheduledJob(row.RepoPath, jobId, row.Plan.PlanId));

        _queuedPlanId = row.Plan.PlanId;
        _messageTone = SbBannerTone.Ok;
        _message = $"'{row.Plan.Name}' kuyruğa alındı. İlerlemeyi İş geçmişi sayfasından izleyebilirsiniz.";
    }

    private async Task CreatePlanAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_form.RepoPath))
        {
            _formError = "Bir depo seçin.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _formError = "Plana bir ad verin.";
            return;
        }

        if (_form.SourcePaths.Count == 0)
        {
            _formError = "En az bir kaynak yol seçin.";
            return;
        }

        string cron;
        try
        {
            if (_form.UseSimpleScheduler && _form.SelectedDays.Count == 0)
            {
                _formError = "En az bir gün seçin.";
                return;
            }

            cron = _form.UseSimpleScheduler ? BuildCron() : _form.Cron;
            Cronos.CronExpression.Parse(cron, Cronos.CronFormat.Standard);
        }
        catch (Exception ex) when (ex is ArgumentException or Cronos.CronFormatException)
        {
            _formError = $"Zamanlama oluşturulamadı: {ex.Message}";
            return;
        }

        var hasRetention = _form.KeepLast is not null || _form.KeepDaily is not null || _form.KeepWeekly is not null
            || _form.KeepMonthly is not null || _form.KeepYearly is not null;
        var retentionJson = hasRetention
            ? JsonSerializer.Serialize(new RetentionPolicy(
                _form.KeepLast, null, _form.KeepDaily, _form.KeepWeekly, _form.KeepMonthly, _form.KeepYearly))
            : null;

        await using var db = CatalogDbContextFactory.Create(Path.Combine(_form.RepoPath, "catalog.db"));
        db.Plans.Add(new PlanEntity
        {
            PlanId = Guid.NewGuid().ToString("n"),
            Name = _form.Name,
            SourcePathsJson = JsonSerializer.Serialize(_form.SourcePaths),
            CronSchedule = cron,
            RetentionPolicyJson = retentionJson,
            CreatedAtUtc = DateTimeOffset.UtcNow,
        });
        await db.SaveChangesAsync();

        _createDialogOpen = false;
        _messageTone = SbBannerTone.Ok;
        _message = $"'{_form.Name}' planı oluşturuldu.";
        await LoadPlansAsync();
    }
}
