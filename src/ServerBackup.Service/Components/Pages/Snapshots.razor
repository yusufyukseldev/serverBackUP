@page "/snapshots"
@using System.Security.Cryptography
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ServerBackup.Core.Crypto
@using ServerBackup.Core.Trees
@using ServerBackup.Data
@using ServerBackup.Data.Entities
@using ServerBackup.Engine.Repository
@using ServerBackup.Service.Formatting
@using ServerBackup.Service.Scheduling
@using ServerBackup.Service.Storage
@implements IDisposable
@inject RepositoryRegistry Repos
@inject NavigationManager Nav

<PageHeader Title="Snapshot'lar" />

<div class="sb-content">
    <div class="sb-stack">
        <div class="sb-row sb-row--wrap">
            <SbField Label="Depo" For="f-snap-repo" Width="SbFieldWidth.Md">
                <select class="sb-select" id="f-snap-repo" @bind="_selectedRepo" @bind:after="OnRepoChangedAsync">
                    <option value="">— depo seçin —</option>
                    @foreach (var repoPath in Repos.Paths)
                    {
                        <option value="@repoPath">@RepoNaming.DisplayName(repoPath)</option>
                    }
                </select>
            </SbField>
        </div>

        @if (_error is not null)
        {
            <SbBanner Tone="SbBannerTone.Err" Icon="alert" Title="@_error" />
        }

        @if (string.IsNullOrEmpty(_selectedRepo))
        {
            <SbCard Title="Snapshot gezgini" Flush="true">
                <SbEmptyState Message="Snapshot'ları görüntülemek için yukarıdan bir depo seçin." />
            </SbCard>
        }
        else if (_masterKey is null)
        {
            <SbCard Title="Bu depo parola korumalı">
                <div class="sb-stack">
                    <div class="sb-row">
                        <SbIcon Name="lock" />
                        <span>Snapshot'ları listelemek için deponun kilidini açın.</span>
                    </div>
                    <SbField Label="Depo parolası" For="f-snap-pwd" Width="SbFieldWidth.Md">
                        <input class="sb-input" type="password" id="f-snap-pwd" @bind="_password" />
                    </SbField>
                    <div>
                        <SbButton Variant="SbButtonVariant.Primary" OnClick="UnlockAsync">Kilidi aç</SbButton>
                    </div>
                </div>
            </SbCard>
        }
        else if (_selectedSnapshot is null)
        {
            <SbCard Title="@($"{_snapshots?.Count ?? 0} snapshot")" Flush="true">
                @if (_snapshots is null)
                {
                    <div class="sb-card-body"><SbSkeleton /></div>
                }
                else if (_snapshots.Count == 0)
                {
                    <SbEmptyState Message="Bu depoda henüz snapshot yok. Depolar sayfasından ilk yedeği alabilirsiniz." />
                }
                else
                {
                    <div class="sb-table-wrap">
                        <table class="sb-table">
                            <thead>
                                <tr>
                                    <th scope="col">Tarih</th>
                                    <th scope="col">Snapshot</th>
                                    <th scope="col">Kaynaklar</th>
                                    <th scope="col" class="r">Süre</th>
                                    <th scope="col"><span class="sb-sr-only">Eylemler</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in _snapshots)
                                {
                                    <tr>
                                        <td class="num">@Fmt.DateTime(s.StartedAtUtc)</td>
                                        <td class="id" title="@s.SnapshotId">@s.SnapshotId[..8]</td>
                                        <td class="path" title="@SourcePathsOf(s.SnapshotId)">@SourcePathsOf(s.SnapshotId)</td>
                                        <td class="r num">@DurationOf(s)</td>
                                        <td class="r">
                                            <div class="sb-row sb-row--tight">
                                                <SbButton Size="SbButtonSize.Sm"
                                                          AriaLabel="@($"{Fmt.DateTime(s.StartedAtUtc)} tarihli snapshot'a gözat")"
                                                          OnClick="() => OpenSnapshotAsync(s)">Gözat</SbButton>
                                                <SbButton Size="SbButtonSize.Sm" Icon="restore"
                                                          AriaLabel="@($"{Fmt.DateTime(s.StartedAtUtc)} tarihli yedeğe dön")"
                                                          OnClick="() => RevertTo(s)">Bu yedeğe dön</SbButton>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </SbCard>
        }
        else
        {
            <SbCard Title="@($"Snapshot {_selectedSnapshot.SnapshotId[..8]}")" Flush="true">
                <HeaderActions>
                    <SbButton Size="SbButtonSize.Sm" Icon="restore" OnClick="CloseSnapshot">Snapshot listesi</SbButton>
                </HeaderActions>
                <ChildContent>
                    <nav class="sb-picker-crumbs" aria-label="Klasör yolu">
                        <button type="button" class="sb-crumb" @onclick="() => GoToDepthAsync(0)">/</button>
                        @for (var i = 0; i < _trail.Count; i++)
                        {
                            var depth = i + 1;
                            <button type="button" class="sb-crumb" @onclick="() => GoToDepthAsync(depth)">@_trail[i].Name</button>
                        }
                    </nav>

                    @if (_currentNodes is null)
                    {
                        <div class="sb-card-body"><SbSkeleton Rows="3" /></div>
                    }
                    else if (_currentNodes.Count == 0)
                    {
                        <SbEmptyState Message="Bu klasör boş." />
                    }
                    else
                    {
                        <div class="sb-table-wrap">
                            <table class="sb-table">
                                <thead>
                                    <tr>
                                        <th scope="col"><span class="sb-sr-only">Tür</span></th>
                                        <th scope="col">Ad</th>
                                        <th scope="col" class="r">Boyut</th>
                                        <th scope="col">Değiştirilme</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var node in SortedNodes)
                                    {
                                        <tr class="is-clickable @(_selectedFile?.Name == node.Name && node.Kind == TreeNodeKind.File ? "is-active" : "")"
                                            tabindex="0"
                                            @onclick="() => ActivateAsync(node)"
                                            @onkeydown="e => OnNodeKeyDown(e, node)">
                                            <td><SbIcon Name="@(node.Kind == TreeNodeKind.Directory ? "folder" : "file")" Small="true" /></td>
                                            <td class="sb-name">@node.Name</td>
                                            <td class="r num">@(node.Kind == TreeNodeKind.Directory ? "—" : Fmt.Bytes(node.Size))</td>
                                            <td class="num">@Fmt.DateTime(DateTimeOffset.FromFileTime(node.ModifiedAtFileTimeUtc))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </ChildContent>
            </SbCard>
        }
    </div>
</div>

<SbDrawer Title="Dosya ayrıntısı" Open="@(_selectedFile is not null)" OnClose="() => _selectedFile = null">
    @if (_selectedFile is { } file)
    {
        <dl class="sb-dl">
            <dt>Ad</dt><dd class="sb-name">@file.Name</dd>
            <dt>Snapshot içindeki yol</dt><dd class="mono">@RelativePathOf(file.Name)</dd>
            <dt>Boyut</dt><dd>@Fmt.Bytes(file.Size)</dd>
            <dt>Değiştirilme</dt><dd>@Fmt.DateTime(DateTimeOffset.FromFileTime(file.ModifiedAtFileTimeUtc))</dd>
            <dt>Parça sayısı</dt><dd>@(file.ChunkBlobIdsHex?.Count ?? 0)</dd>
            <dt>İzinler</dt><dd>@(file.Sddl is null ? "Kaydedilmemiş" : "Kaynaktaki haliyle saklandı")</dd>
        </dl>

        <SbBanner Tone="SbBannerTone.Neutral" Icon="lock"
                  Title="İçerik burada gösterilmez"
                  Body="Listedeki bilgiler klasör ağacından okunur; dosyanın kendisi ancak geri yüklenirken çözülür." />

        <SbButton Variant="SbButtonVariant.Primary" Icon="restore" OnClick="() => RestoreFile(file)">
            Bu dosyayı geri yükle
        </SbButton>
    }
</SbDrawer>

@code {
    private sealed record Crumb(string Name, string TreeBlobIdHex);

    private string? _selectedRepo;
    private string? _password;
    private byte[]? _masterKey;
    private string? _error;

    private List<SnapshotEntity>? _snapshots;
    private Dictionary<string, string> _snapshotSources = [];
    private SnapshotEntity? _selectedSnapshot;

    /// <summary>Each level's tree blob id, so going up is a pop instead of re-walking the tree from the root.</summary>
    private readonly List<Crumb> _trail = [];
    private List<TreeNode>? _currentNodes;
    private TreeNode? _selectedFile;

    private IEnumerable<TreeNode> SortedNodes => (_currentNodes ?? [])
        .OrderByDescending(n => n.Kind == TreeNodeKind.Directory)
        .ThenBy(n => n.Name, StringComparer.CurrentCultureIgnoreCase);

    private async Task OnRepoChangedAsync()
    {
        _error = null;
        _snapshots = null;
        _selectedSnapshot = null;
        _trail.Clear();
        _currentNodes = null;
        ClearKey();

        if (string.IsNullOrEmpty(_selectedRepo))
        {
            return;
        }

        if (!File.Exists(Path.Combine(_selectedRepo, "catalog.db")))
        {
            _error = "Bu yolda bir depo bulunamadı.";
            return;
        }

        if (UnattendedKeyStore.IsEnabled(_selectedRepo))
        {
            _masterKey = UnattendedKeyStore.Unlock(_selectedRepo);
            await LoadSnapshotsAsync();
        }
    }

    private async Task UnlockAsync()
    {
        if (string.IsNullOrEmpty(_selectedRepo) || string.IsNullOrEmpty(_password))
        {
            _error = "Depo parolasını girin.";
            return;
        }

        try
        {
            _masterKey = await RepositoryKeyStore.UnlockAsync(_selectedRepo, _password);
            _password = null;
            _error = null;
            await LoadSnapshotsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            _error = "Parola yanlış.";
        }
    }

    private async Task LoadSnapshotsAsync()
    {
        if (_selectedRepo is null)
        {
            return;
        }

        await using var db = CatalogDbContextFactory.Create(Path.Combine(_selectedRepo, "catalog.db"));
        _snapshots = (await db.Snapshots.AsNoTracking().ToListAsync())
            .OrderByDescending(s => s.StartedAtUtc)
            .ToList();

        var paths = await db.SnapshotPaths.AsNoTracking().ToListAsync();
        _snapshotSources = paths
            .GroupBy(p => p.SnapshotId)
            .ToDictionary(g => g.Key, g => string.Join(", ", g.Select(p => p.SourcePath)));
    }

    private string SourcePathsOf(string snapshotId) =>
        _snapshotSources.TryGetValue(snapshotId, out var value) ? value : "—";

    private static string DurationOf(SnapshotEntity snapshot) =>
        snapshot.FinishedAtUtc is { } finished ? Fmt.Duration(finished - snapshot.StartedAtUtc) : "—";

    private async Task OpenSnapshotAsync(SnapshotEntity snapshot)
    {
        _selectedSnapshot = snapshot;
        _trail.Clear();
        _currentNodes = null;
        await LoadNodesAsync(snapshot.RootTreeBlobId);
    }

    /// <summary>
    /// Hands off to the restore wizard rather than starting anything here: the
    /// confirmation for overwriting live files belongs on one page, not two.
    /// </summary>
    private void RevertTo(SnapshotEntity snapshot) =>
        Nav.NavigateTo($"restore?repo={Uri.EscapeDataString(_selectedRepo ?? "")}&snapshot={snapshot.SnapshotId}&mode=inplace");

    private void CloseSnapshot()
    {
        _selectedSnapshot = null;
        _trail.Clear();
        _currentNodes = null;
    }

    /// <summary>
    /// A row click means "show me this": a folder opens, a file opens its
    /// details. Rows used to be inert unless they were an openable folder,
    /// which reads as a broken table.
    /// </summary>
    private async Task ActivateAsync(TreeNode node)
    {
        if (node.Kind == TreeNodeKind.File)
        {
            _selectedFile = node;
            return;
        }

        await OpenDirectoryAsync(node);
    }

    private async Task OpenDirectoryAsync(TreeNode node)
    {
        if (node.Kind != TreeNodeKind.Directory || node.SubTreeBlobIdHex is null)
        {
            return;
        }

        _selectedFile = null;
        _trail.Add(new Crumb(node.Name, node.SubTreeBlobIdHex));
        await LoadNodesAsync(node.SubTreeBlobIdHex);
    }

    /// <summary>Snapshot-relative path, which is the form a selective restore takes.</summary>
    private string RelativePathOf(string name) =>
        _trail.Count == 0 ? name : $"{string.Join("/", _trail.Select(c => c.Name))}/{name}";

    private void RestoreFile(TreeNode file) =>
        Nav.NavigateTo(
            $"restore?repo={Uri.EscapeDataString(_selectedRepo ?? "")}"
            + $"&snapshot={_selectedSnapshot!.SnapshotId}"
            + $"&path={Uri.EscapeDataString(RelativePathOf(file.Name))}");

    private async Task GoToDepthAsync(int depth)
    {
        if (_selectedSnapshot is null || depth > _trail.Count)
        {
            return;
        }

        var treeBlobId = depth == 0 ? _selectedSnapshot.RootTreeBlobId : _trail[depth - 1].TreeBlobIdHex;
        _trail.RemoveRange(depth, _trail.Count - depth);
        await LoadNodesAsync(treeBlobId);
    }

    private async Task OnNodeKeyDown(KeyboardEventArgs e, TreeNode node)
    {
        if (e.Key is "Enter" or " " or "ArrowRight")
        {
            await ActivateAsync(node);
        }
        else if (e.Key is "Backspace" or "ArrowLeft" && _trail.Count > 0)
        {
            await GoToDepthAsync(_trail.Count - 1);
        }
    }

    private async Task LoadNodesAsync(string treeBlobIdHex)
    {
        if (_selectedRepo is null || _masterKey is null)
        {
            return;
        }

        try
        {
            var packSubKey = SubKeys.Derive(_masterKey, SubKeys.PackKeyInfo);
            await using var db = CatalogDbContextFactory.Create(Path.Combine(_selectedRepo, "catalog.db"));
            using var blobStore = new BlobStore(_selectedRepo, packSubKey, db);

            var bytes = await blobStore.ReadBlobAsync(treeBlobIdHex);
            _currentNodes = Tree.Deserialize(bytes).Nodes.ToList();
            _error = null;
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or CryptographicException)
        {
            _currentNodes = [];
            _error = "Bu klasör okunamadı; depo bozulmuş olabilir. Depolar sayfasından doğrulama çalıştırın.";
        }
    }

    private void ClearKey()
    {
        if (_masterKey is not null)
        {
            CryptographicOperations.ZeroMemory(_masterKey);
            _masterKey = null;
        }
    }

    public void Dispose() => ClearKey();
}
