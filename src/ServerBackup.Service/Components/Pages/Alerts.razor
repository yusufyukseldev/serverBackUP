@page "/alerts"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ServerBackup.Data
@using ServerBackup.Data.Entities
@using ServerBackup.Service.Scheduling
@inject IOptions<ServerBackupOptions> Options

<div class="sb-content">
<h1>Uyarılar</h1>

@if (_failedJobs is null)
{
    <p>Yükleniyor...</p>
}
else if (_failedJobs.Count == 0)
{
    <p>Açık uyarı yok.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Depo</th>
                <th>İş</th>
                <th>Başlangıç</th>
                <th>Hata</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (repoPath, job) in _failedJobs)
            {
                <tr>
                    <td>@repoPath</td>
                    <td>@job.JobId</td>
                    <td>@(job.StartedAtUtc?.ToString("u") ?? "-")</td>
                    <td>@(job.ErrorMessage ?? "-")</td>
                </tr>
            }
        </tbody>
    </table>
}
</div>

@code {
    private List<(string RepoPath, JobEntity Job)>? _failedJobs;

    protected override async Task OnInitializedAsync()
    {
        var jobs = new List<(string, JobEntity)>();

        foreach (var repoPath in Options.Value.Repositories)
        {
            var dbPath = Path.Combine(repoPath, "catalog.db");
            if (!File.Exists(dbPath))
            {
                continue;
            }

            await using var db = CatalogDbContextFactory.Create(dbPath);
            foreach (var job in await db.Jobs.AsNoTracking().Where(j => j.Status == "Failed").ToListAsync())
            {
                jobs.Add((repoPath, job));
            }
        }

        _failedJobs = jobs.OrderByDescending(j => j.Item2.StartedAtUtc).ToList();
    }
}
