@inject IJSRuntime JS

@* The icon shows what a click gives you, not the current state: a moon means
   "switch to dark". Labelling the destination is what makes a single-button
   toggle readable without a caption. *@
<button type="button" class="sb-theme-toggle"
        title="@Label" aria-label="@Label"
        @onclick="ToggleAsync">
    <SbIcon Name="@(_theme == "dark" ? "sun" : "moon")" Small="true" />
    <span>@(_theme == "dark" ? "Açık tema" : "Koyu tema")</span>
</button>

@code {
    /// <summary>Unknown until the first interop call — the preference lives in the browser, not on the server.</summary>
    private string? _theme;

    private string Label => _theme == "dark" ? "Açık temaya geç" : "Koyu temaya geç";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _theme = await JS.InvokeAsync<string>("sbTheme.get");
        StateHasChanged();
    }

    private async Task ToggleAsync() => _theme = await JS.InvokeAsync<string>("sbTheme.toggle");
}
