@using ServerBackup.Service.Formatting
@using ServerBackup.Service.Storage

<div class="sb-picker">
    <div class="sb-picker-chosen">
        @if (Paths.Count == 0)
        {
            <p class="sb-hint">@(Single ? "Henüz klasör seçilmedi." : "Henüz kaynak yol seçilmedi.")</p>
        }
        else
        {
            <ul class="sb-chips">
                @foreach (var path in Paths)
                {
                    <li class="sb-chip">
                        <SbIcon Name="@(IsDriveRoot(path) ? "hdd" : "folder")" Small="true" />
                        <span class="sb-chip-t" title="@path">@ShortLabel(path)</span>
                        <button type="button" class="sb-chip-x" title="@($"{path} yolunu kaldır")"
                                aria-label="@($"{path} yolunu kaldır")" @onclick="() => RemoveAsync(path)">
                            <SbIcon Name="x" Small="true" />
                        </button>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="sb-picker-browser">
        @* One bar, not three: drives, location and the add action sit together so
           the browser stays short enough to use inside a dialog. *@
        <div class="sb-picker-bar">
            <div class="sb-picker-drives" role="group" aria-label="Diskler">
                @foreach (var drive in _drives)
                {
                    <button type="button"
                            class="sb-drive @(IsCurrentDrive(drive.RootPath) ? "is-active" : "")"
                            aria-pressed="@(IsCurrentDrive(drive.RootPath) ? "true" : "false")"
                            title="@($"{drive.Label} — {Fmt.Bytes(drive.FreeBytes)} boş / {Fmt.Bytes(drive.TotalBytes)}")"
                            @onclick="() => Browse(drive.RootPath)">
                        @drive.RootPath.TrimEnd('\\')
                    </button>
                }
            </div>

            @if (_current is not null)
            {
                <nav class="sb-picker-crumbs" aria-label="Klasör yolu">
                    @foreach (var ancestor in FileSystemBrowser.GetAncestors(_current))
                    {
                        <button type="button" class="sb-crumb" @onclick="() => Browse(ancestor)">@CrumbLabel(ancestor)</button>
                    }
                </nav>

                <SbButton Size="SbButtonSize.Sm" Variant="SbButtonVariant.Primary" Icon="@(Single ? "check" : "plus")"
                          OnClick="() => AddAsync(_current)"
                          AriaLabel="@AddLabel(_current)"
                          Disabled="@Paths.Contains(_current)"
                          DisabledReason="@(Paths.Contains(_current) ? (Single ? "Bu klasör zaten seçili" : "Bu yol zaten listede") : null)">
                    @(Single ? "Bu klasörü seç" : IsDriveRoot(_current) ? "Diskin tamamı" : "Bu klasör")
                </SbButton>
            }
        </div>

        <ul class="sb-picker-list">
            @if (_children.Count == 0)
            {
                <li class="sb-picker-empty">Bu klasörde alt klasör yok veya okuma izni bulunmuyor.</li>
            }
            else
            {
                @foreach (var child in _children)
                {
                    <li>
                        <button type="button" class="sb-picker-open"
                                aria-label="@($"{Path.GetFileName(child)} klasörünü aç")"
                                @onclick="() => Browse(child)">
                            <SbIcon Name="folder" Small="true" />
                            <span>@Path.GetFileName(child)</span>
                        </button>
                        @* Her satırda çıplak "Ekle" ekran okuyucuda ayırt edilemez — ad klasörü söylemeli. *@
                        <SbButton Size="SbButtonSize.Sm" Variant="SbButtonVariant.Subtle"
                                  AriaLabel="@AddLabel(child)"
                                  OnClick="() => AddAsync(child)"
                                  Disabled="@Paths.Contains(child)"
                                  DisabledReason="@(Paths.Contains(child) ? (Single ? "Bu klasör zaten seçili" : "Bu yol zaten listede") : null)">
                            @(Single ? "Seç" : "Ekle")
                        </SbButton>
                    </li>
                }
            }
        </ul>
    </div>
</div>

@code {
    /// <summary>Chosen source paths. Owned by the parent; this component never mutates the list in place.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Paths { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback<IReadOnlyList<string>> PathsChanged { get; set; }

    /// <summary>One folder instead of a set — picking replaces the selection rather than appending to it.</summary>
    [Parameter]
    public bool Single { get; set; }

    private IReadOnlyList<FileSystemBrowser.DriveItem> _drives = [];
    private IReadOnlyList<string> _children = [];
    private string? _current;

    protected override void OnInitialized()
    {
        _drives = FileSystemBrowser.GetFixedDrives();

        // Reopening a picker that already has a choice on the volume's root
        // would make the operator navigate back to it every time.
        var start = Paths.LastOrDefault(FileSystemBrowser.DirectoryExists) ?? _drives.FirstOrDefault()?.RootPath;
        if (start is not null)
        {
            Browse(start);
        }
    }

    private void Browse(string path)
    {
        _current = path;
        _children = FileSystemBrowser.GetSubdirectories(path);
    }

    private Task AddAsync(string path) => Paths.Contains(path)
        ? Task.CompletedTask
        : PathsChanged.InvokeAsync(Single ? [path] : [.. Paths, path]);

    private string AddLabel(string path) => Single
        ? $"{CrumbLabel(path)} klasörünü hedef olarak seç"
        : $"{path} yolunu kaynak yollara ekle";

    private Task RemoveAsync(string path) =>
        PathsChanged.InvokeAsync(Paths.Where(p => p != path).ToList());

    private bool IsCurrentDrive(string rootPath) =>
        _current is not null && string.Equals(Path.GetPathRoot(_current), rootPath, StringComparison.OrdinalIgnoreCase);

    private static bool IsDriveRoot(string path) =>
        string.Equals(Path.GetPathRoot(path), path, StringComparison.OrdinalIgnoreCase);

    private static string CrumbLabel(string path) =>
        Path.GetFileName(path.TrimEnd(Path.DirectorySeparatorChar)) is { Length: > 0 } name
            ? name
            : path.TrimEnd(Path.DirectorySeparatorChar);

    /// <summary>A chip shows the tail of the path; the full path stays in the tooltip.</summary>
    private string ShortLabel(string path) =>
        IsDriveRoot(path) && !Single ? $"{path.TrimEnd(Path.DirectorySeparatorChar)} (tüm disk)" : Fmt.TruncatePath(path, 34);
}
